generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Physiotherapist {
  id               Int                   @id @default(autoincrement())
  name             String
  email            String                @unique
  phone            String?
  crefito          String                @unique
  cpf              String                @unique
  rg               String?
  birthDate        DateTime?
  address          String?
  startDate        DateTime
  exitDate         DateTime?
  hourValue        Decimal               @default(0) @db.Decimal(10, 2) // Renomeado de shiftValue
  additionalValue  Decimal               @default(0) @db.Decimal(10, 2)
  status           ContractStatus        @default(ACTIVE)
  contractType     ContractType
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  agencia          String?
  banco            String?
  chavePix         String?
  cnpjEmpresa      String?
  conta            String?
  enderecoEmpresa  String?
  nomeEmpresa      String?
  tipoPix          String?
  teams            PhysiotherapistTeam[] // Relação many-to-many com equipes
  shifts           Shift[]
  users            User[]                @relation("UserPhysiotherapist") // Um fisioterapeuta pode ter múltiplos usuários
  paymentRecords   PaymentRecord[]       @relation("PaymentRecords")
  financialClosingLines FinancialClosingLine[]
  financialDocuments FinancialDocument[]
  swapRequests     ShiftSwapRequest[]    @relation("SwapRequester") // Trocas solicitadas
  swapTargets      ShiftSwapRequest[]    @relation("SwapTarget") // Trocas direcionadas a este fisio
  swapResponses    ShiftSwapRequest[]    @relation("SwapResponder") // Trocas respondidas
  shiftSeries      ShiftSeries[]
  telegramChatId   String? // ID do chat do Telegram
  telegramUsername String? // @username do Telegram
  notificationLogs NotificationLog[]     @relation("PhysiotherapistNotifications")
}

model ShiftTeam {
  id                       Int                     @id @default(autoincrement())
  name                     String                  @unique
  // Campos antigos (mantidos por compatibilidade - serão removidos futuramente)
  morningSlots             Int                     @default(0)
  intermediateSlots        Int                     @default(0)
  afternoonSlots           Int                     @default(0)
  nightSlots               Int                     @default(0)
  // Novos campos para dias úteis (segunda a sexta)
  weekdayMorningSlots      Int                     @default(0)
  weekdayIntermediateSlots Int                     @default(0)
  weekdayAfternoonSlots    Int                     @default(0)
  weekdayNightSlots        Int                     @default(0)
  // Novos campos para fins de semana e feriados
  weekendMorningSlots      Int                     @default(0)
  weekendIntermediateSlots Int                     @default(0)
  weekendAfternoonSlots    Int                     @default(0)
  weekendNightSlots        Int                     @default(0)
  shiftValue               Decimal                 @default(0) @db.Decimal(10, 2) // Novo campo para valor do plantão
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  physiotherapists         PhysiotherapistTeam[] // Relação many-to-many com fisioterapeutas
  shiftSlots               ShiftTeamSlot[]
  shifts                   Shift[]
  shiftSeries              ShiftSeries[]
  priceHistory             ShiftTeamPriceHistory[] // Histórico de alterações de valor
}

model ShiftTeamSlot {
  id          Int              @id @default(autoincrement())
  shiftTeamId Int
  period      ShiftPeriod
  dayType     ShiftSlotDayType
  description String
  sortOrder   Int
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  shiftTeam   ShiftTeam        @relation(fields: [shiftTeamId], references: [id], onDelete: Cascade)
  shifts      Shift[]
  shiftSeries ShiftSeries[]

  @@unique([shiftTeamId, period, dayType, sortOrder])
  @@index([shiftTeamId, dayType, period, isActive, sortOrder])
}

model Shift {
  id                Int                   @id @default(autoincrement())
  date              DateTime
  period            ShiftPeriod
  physiotherapistId Int
  shiftTeamId       Int
  shiftTeamSlotId   Int
  shiftSeriesId     Int?
  isSeriesException Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  physiotherapist   Physiotherapist       @relation(fields: [physiotherapistId], references: [id])
  shiftTeam         ShiftTeam             @relation(fields: [shiftTeamId], references: [id])
  shiftTeamSlot     ShiftTeamSlot         @relation(fields: [shiftTeamSlotId], references: [id])
  shiftSeries       ShiftSeries?          @relation(fields: [shiftSeriesId], references: [id], onDelete: SetNull)
  seriesException   ShiftSeriesException?
  swapRequests      ShiftSwapRequest[] // Solicitações de troca para este plantão
  notificationLogs  NotificationLog[]     @relation("ShiftNotifications")

  @@unique([date, period, physiotherapistId])
  @@unique([date, shiftTeamSlotId])
  @@index([shiftSeriesId, date])
}

model ShiftSeries {
  id                Int                    @id @default(autoincrement())
  shiftTeamId       Int
  physiotherapistId Int
  shiftTeamSlotId   Int
  period            ShiftPeriod
  startDate         DateTime               @db.Date
  endDate           DateTime               @db.Date
  weekdays          Int[]
  status            ShiftSeriesStatus      @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  shiftTeam         ShiftTeam              @relation(fields: [shiftTeamId], references: [id], onDelete: Cascade)
  physiotherapist   Physiotherapist        @relation(fields: [physiotherapistId], references: [id], onDelete: Cascade)
  shiftTeamSlot     ShiftTeamSlot          @relation(fields: [shiftTeamSlotId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  exceptions        ShiftSeriesException[]

  @@index([shiftTeamId, status])
  @@index([physiotherapistId, status])
}

model ShiftSeriesException {
  id             Int                      @id @default(autoincrement())
  shiftSeriesId  Int
  occurrenceDate DateTime                 @db.Date
  type           ShiftSeriesExceptionType
  shiftId        Int?                     @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  shiftSeries    ShiftSeries              @relation(fields: [shiftSeriesId], references: [id], onDelete: Cascade)
  shift          Shift?                   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([shiftSeriesId, occurrenceDate])
  @@index([shiftSeriesId, occurrenceDate])
}

// ==========================================
// SISTEMA DE TROCAS DE PLANTÕES
// ==========================================

model ShiftSwapRequest {
  id             Int        @id @default(autoincrement())
  shiftId        Int // Plantão que quer trocar
  requesterId    Int // Quem está pedindo a troca
  targetPhysioId Int? // Para quem está oferecendo (null = aberto para todos)
  status         SwapStatus @default(PENDING)
  reason         String? // Motivo da troca
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  respondedAt    DateTime?
  responderId    Int? // Quem aceitou a troca
  approvedBy     Int? // Gestor/Admin que aprovou (se necessário)
  approvedAt     DateTime? // Data de aprovação

  shift        Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requester    Physiotherapist  @relation("SwapRequester", fields: [requesterId], references: [id])
  targetPhysio Physiotherapist? @relation("SwapTarget", fields: [targetPhysioId], references: [id])
  responder    Physiotherapist? @relation("SwapResponder", fields: [responderId], references: [id])
  approver     User?            @relation("SwapApprover", fields: [approvedBy], references: [id])
}

model User {
  id                                     Int                               @id @default(autoincrement())
  email                                  String                            @unique
  name                                   String
  password                               String
  role                                   UserRole                          @default(USER)
  isFirstLogin                           Boolean                           @default(true)
  mustChangePassword                     Boolean                           @default(true)
  twoFactorEnabled                       Boolean                           @default(false)
  twoFactorSecretEncrypted               String?
  twoFactorRecoveryCodeHashes            String[]                          @default([])
  twoFactorEnabledAt                     DateTime?
  physiotherapistId                      Int?
  createdAt                              DateTime                          @default(now())
  updatedAt                              DateTime                          @updatedAt
  createdBy                              Int?
  creator                                User?                             @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers                           User[]                            @relation("UserCreator")
  physiotherapist                        Physiotherapist?                  @relation("UserPhysiotherapist", fields: [physiotherapistId], references: [id])
  swapApprovals                          ShiftSwapRequest[]                @relation("SwapApprover")
  teamPriceChanges                       ShiftTeamPriceHistory[]           @relation("PriceChangeUser")
  physiotherapistTeamPriceChanges        PhysiotherapistTeamPriceHistory[] @relation("CustomPriceChangeUser")
  updatedTeamPriceChanges                ShiftTeamPriceHistory[]           @relation("PriceUpdateUser")
  updatedPhysiotherapistTeamPriceChanges PhysiotherapistTeamPriceHistory[] @relation("CustomPriceUpdateUser")
  accessLogs                             UserAccessLog[]
  financialClosingsCreated               FinancialClosing[]                @relation("FinancialClosingCreatedBy")
  financialClosingsApproved              FinancialClosing[]                @relation("FinancialClosingApprovedBy")
  financialClosingLinesCreated           FinancialClosingLine[]             @relation("FinancialClosingLineCreatedBy")
  financialClosingLinesUpdated           FinancialClosingLine[]             @relation("FinancialClosingLineUpdatedBy")
  financialAdjustmentsCreated            FinancialAdjustment[]             @relation("FinancialAdjustmentCreatedBy")
  financialDocumentsUploaded             FinancialDocument[]               @relation("FinancialDocumentUploadedBy")
  financialAuditEvents                   FinancialAuditEvent[]             @relation("FinancialAuditActor")
  financialBatchesCreated                PaymentBatch[]                    @relation("PaymentBatchCreatedBy")
  trustedTwoFactorDevices                TrustedTwoFactorDevice[]
}

model TrustedTwoFactorDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique
  label      String?
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Modelo de junção para relação many-to-many entre Physiotherapist e ShiftTeam
model PhysiotherapistTeam {
  id                Int                               @id @default(autoincrement())
  physiotherapistId Int
  shiftTeamId       Int
  customShiftValue  Decimal?                          @db.Decimal(10, 2) // Valor customizado do plantão para este fisioterapeuta nesta equipe
  isActive          Boolean                           @default(true)
  physiotherapist   Physiotherapist                   @relation(fields: [physiotherapistId], references: [id], onDelete: Cascade)
  shiftTeam         ShiftTeam                         @relation(fields: [shiftTeamId], references: [id], onDelete: Cascade)
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  priceHistory      PhysiotherapistTeamPriceHistory[] // Histórico de alterações de valor customizado

  @@unique([physiotherapistId, shiftTeamId])
  @@index([physiotherapistId, isActive])
  @@index([shiftTeamId, isActive])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// CONFIGURAÇÕES DO SISTEMA
// ==========================================

model SystemSettings {
  id                   Int      @id @default(autoincrement())
  swapRequiresApproval Boolean  @default(true) // Se trocas precisam de aprovação de gestor/admin
  googleTokenEncrypted String?
  googleTokenUpdatedAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model NotificationSettings {
  id                           Int     @id @default(autoincrement())
  enabled                      Boolean @default(true)
  dailyReminderEnabled         Boolean @default(true)
  dailyReminderTime            String  @default("18:00") // Horário do lembrete diário
  instantNotificationEnabled   Boolean @default(true)
  shiftDeletionTelegramEnabled Boolean @default(false) // Alerta gestores/admins quando fisioterapeuta exclui plantÃ£o

  // Templates de mensagem personalizáveis
  dailyReminderTemplate       String @default("🏥 Lembrete de Plantão\n\nOlá, {{name}}! 👋\n\nVocê está escalado para amanhã:\n\n📅 Data: {{date}}\n⏰ Período: {{period}}\n🏢 Equipe: {{team}}\n\nBoa sorte! 💪")
  instantNotificationTemplate String @default("✅ Novo Plantão Cadastrado\n\nOlá, {{name}}!\n\nVocê foi escalado para:\n\n📅 Data: {{date}}\n⏰ Período: {{period}}\n🏢 Equipe: {{team}}\n\nConfira no sistema!")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id                Int      @id @default(autoincrement())
  physiotherapistId Int
  shiftId           Int?
  sentAt            DateTime @default(now())
  status            String // 'sent', 'failed', 'pending'
  platform          String   @default("telegram") // 'telegram', 'whatsapp', 'email'
  messageType       String // 'daily_reminder', 'instant_notification'
  errorMessage      String?

  physiotherapist Physiotherapist @relation("PhysiotherapistNotifications", fields: [physiotherapistId], references: [id], onDelete: Cascade)
  shift           Shift?          @relation("ShiftNotifications", fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([physiotherapistId, sentAt])
  @@index([shiftId])
}

model ShiftDeletionLog {
  id                  Int         @id @default(autoincrement())
  originalShiftId     Int
  shiftDate           DateTime
  period              ShiftPeriod
  shiftTeamId         Int
  shiftTeamName       String
  physiotherapistId   Int
  physiotherapistName String
  deletedByUserId     Int
  deletedByUserName   String
  deletedByUserRole   UserRole
  deletedOwnShift     Boolean     @default(false)
  notifiedViaTelegram Boolean     @default(false)
  notificationSentAt  DateTime?
  notificationError   String?
  notificationTargets String?
  createdAt           DateTime    @default(now())

  @@index([createdAt])
  @@index([deletedByUserId, createdAt])
  @@index([physiotherapistId, createdAt])
  @@index([shiftTeamId, createdAt])
}

model UserAccessLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  userEmail  String
  userName   String
  userRole   UserRole
  ipAddress  String?
  userAgent  String?
  loggedInAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loggedInAt])
  @@index([userId, loggedInAt])
  @@index([userEmail, loggedInAt])
}

model BackupLog {
  id               Int      @id @default(autoincrement())
  triggerType      String // 'manual_download', 'manual_drive', 'cron_drive'
  status           String // 'success', 'failed'
  fileName         String?
  fileSize         Int?
  storageTarget    String? // 'local_download', 'google_drive'
  driveFileId      String?
  driveFileName    String?
  driveWebViewLink String?
  errorMessage     String?
  createdByUserId  Int?
  createdByName    String?
  createdByEmail   String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([triggerType, createdAt])
  @@index([status, createdAt])
}

enum ContractStatus {
  ACTIVE
  INACTIVE
}

enum ContractType {
  PJ
  RPA
  NO_CONTRACT
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum ShiftPeriod {
  MORNING
  INTERMEDIATE
  AFTERNOON
  NIGHT
}

enum ShiftSlotDayType {
  WEEKDAY
  WEEKEND
}

enum ShiftSeriesStatus {
  ACTIVE
  CANCELLED
}

enum ShiftSeriesExceptionType {
  SKIP
  MODIFIED
}

enum SwapStatus {
  PENDING // Aguardando resposta do fisioterapeuta
  PENDING_APPROVAL // Aguardando aprovação do gestor/admin
  ACCEPTED // Aceito
  REJECTED // Rejeitado
  CANCELLED // Cancelado pelo solicitante
  EXPIRED // Expirado (após X dias)
}

// ==========================================
// MÓDULO DE CONTROLE DE PAGAMENTOS MENSAIS
// ==========================================

model MonthlyPaymentControl {
  id             Int                  @id @default(autoincrement())
  referenceMonth String // Formato: "2024-12"
  status         PaymentControlStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  closedAt       DateTime?
  payments       PaymentRecord[]

  @@unique([referenceMonth])
}

model PaymentRecord {
  id               Int                   @id @default(autoincrement())
  monthlyControlId Int
  monthlyControl   MonthlyPaymentControl @relation(fields: [monthlyControlId], references: [id], onDelete: Cascade)

  // Dados do fisioterapeuta (pode ser cadastrado ou não)
  physiotherapistId Int?
  physiotherapist   Physiotherapist? @relation("PaymentRecords", fields: [physiotherapistId], references: [id])

  // Dados manuais (para fisioterapeutas não cadastrados)
  manualName         String?
  manualEmail        String?
  manualContractType ContractType?

  // Valores
  grossValue      Decimal  @db.Decimal(10, 2) // Valor cheio/bruto
  rpaValorServico Decimal? @db.Decimal(10, 2) // Valor do serviço extraído do RPA

  // Descontos RPA (quando aplicável)
  rpaOutrosDescontos Decimal? @db.Decimal(10, 2)
  rpaIss             Decimal? @db.Decimal(10, 2)
  rpaIrrf            Decimal? @db.Decimal(10, 2)
  rpaInss            Decimal? @db.Decimal(10, 2)
  rpaTotalDescontos  Decimal? @db.Decimal(10, 2)

  // Valor final
  netValue Decimal @db.Decimal(10, 2) // Valor líquido a pagar

  // Arquivos no Google Drive
  rpaFileId          String? // ID do arquivo RPA no Drive
  rpaFileName        String?
  nfFileId           String? // ID da Nota Fiscal no Drive (para PJ)
  nfFileName         String?
  pixReceiptFileId   String? // ID do comprovante PIX no Drive
  pixReceiptFileName String?

  // Controle de envio
  emailSentAt DateTime?
  emailStatus EmailStatus @default(PENDING)

  // Controle
  status    PaymentRecordStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([monthlyControlId, physiotherapistId])
}

enum PaymentControlStatus {
  OPEN
  PROCESSING
  CLOSED
}

enum PaymentRecordStatus {
  PENDING
  PAID
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ==========================================
// MÓDULO FINANCEIRO UNIFICADO
// ==========================================

enum FinancialClosingStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED_FOR_PAYMENT
  BANK_FILE_GENERATED
  BANK_SUBMITTED
  PAYMENT_CONFIRMED
  CLOSED
  REOPENED
  ARCHIVED
}

enum FinancialClosingLineStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  LOCKED
  PAID
  CANCELLED
}

enum FinancialAdjustmentType {
  BONUS
  CREDIT
  DEBIT
  DISCOUNT
  CORRECTION
  OTHER
}

enum FinancialDocumentType {
  RPA
  INVOICE
  PIX_RECEIPT
  BANK_FILE
  BANK_RETURN
  EMAIL_RECEIPT
  OTHER
}

enum FinancialDocumentStatus {
  PENDING
  AVAILABLE
  ARCHIVED
  INVALID
}

enum FinancialAuditEventType {
  SNAPSHOT_CREATED
  LINE_CREATED
  ADJUSTMENT_CREATED
  DOCUMENT_REGISTERED
  BATCH_CREATED
  BATCH_GENERATED
  STATUS_CHANGED
  PAYMENT_CONFIRMED
  REOPENED
  AUDIT_NOTE
}

enum PaymentBatchStatus {
  DRAFT
  READY
  GENERATED
  SUBMITTED
  CONFIRMED
  FAILED
  CANCELLED
}

model FinancialClosing {
  id                    Int                    @id @default(autoincrement())
  referenceMonth        String                 @unique
  year                  Int
  month                 Int
  status                FinancialClosingStatus @default(DRAFT)
  snapshotVersion       Int                    @default(1)
  totalPhysiotherapists Int                    @default(0)
  totalShifts           Int                    @default(0)
  totalGrossValue       Decimal                @default(0) @db.Decimal(12, 2)
  totalAdjustmentValue  Decimal                @default(0) @db.Decimal(12, 2)
  totalNetValue         Decimal                @default(0) @db.Decimal(12, 2)
  sourceChecksum        String?
  notes                 String?
  snapshotData          Json?
  generatedAt           DateTime?
  lockedAt              DateTime?
  approvedAt            DateTime?
  closedAt              DateTime?
  reopenedAt            DateTime?
  createdBy             Int?
  approvedBy            Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdByUser         User?                  @relation("FinancialClosingCreatedBy", fields: [createdBy], references: [id])
  approvedByUser        User?                  @relation("FinancialClosingApprovedBy", fields: [approvedBy], references: [id])
  lines                 FinancialClosingLine[]
  adjustments           FinancialAdjustment[]
  documents             FinancialDocument[]
  auditEvents           FinancialAuditEvent[]
  paymentBatches        PaymentBatch[]

  @@index([status, referenceMonth])
  @@index([year, month])
}

model FinancialClosingLine {
  id                    Int                        @id @default(autoincrement())
  financialClosingId    Int
  physiotherapistId     Int
  primaryTeamId         Int?
  primaryTeamName       String?
  physiotherapistName   String
  physiotherapistEmail  String?
  contractType          ContractType
  totalShifts           Int                        @default(0)
  grossCalculatedValue  Decimal                    @db.Decimal(12, 2)
  adjustmentTotalValue  Decimal                    @default(0) @db.Decimal(12, 2)
  netValue              Decimal                    @db.Decimal(12, 2)
  additionalValue       Decimal                    @default(0) @db.Decimal(12, 2)
  status                FinancialClosingLineStatus @default(DRAFT)
  calculationSnapshot   Json?
  shiftDetailsSnapshot  Json?
  teamBreakdownSnapshot  Json?
  lockedAt              DateTime?
  approvedAt            DateTime?
  paidAt                DateTime?
  paymentBatchId        Int?
  createdBy             Int?
  updatedBy             Int?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  financialClosing      FinancialClosing           @relation(fields: [financialClosingId], references: [id], onDelete: Cascade)
  physiotherapist       Physiotherapist            @relation(fields: [physiotherapistId], references: [id], onDelete: Restrict)
  paymentBatch          PaymentBatch?              @relation(fields: [paymentBatchId], references: [id], onDelete: SetNull)
  createdByUser         User?                      @relation("FinancialClosingLineCreatedBy", fields: [createdBy], references: [id])
  updatedByUser         User?                      @relation("FinancialClosingLineUpdatedBy", fields: [updatedBy], references: [id])
  adjustments           FinancialAdjustment[]
  documents             FinancialDocument[]
  auditEvents           FinancialAuditEvent[]

  @@unique([financialClosingId, physiotherapistId])
  @@index([financialClosingId, status])
  @@index([physiotherapistId, financialClosingId])
}

model FinancialAdjustment {
  id                    Int                    @id @default(autoincrement())
  financialClosingId    Int
  financialClosingLineId Int?
  type                  FinancialAdjustmentType
  amount                Decimal                @db.Decimal(12, 2)
  reason                String
  description           String?
  source                String                 @default("MANUAL")
  createdBy             Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialClosing      FinancialClosing       @relation(fields: [financialClosingId], references: [id], onDelete: Cascade)
  financialClosingLine  FinancialClosingLine?   @relation(fields: [financialClosingLineId], references: [id], onDelete: SetNull)
  createdByUser         User?                  @relation("FinancialAdjustmentCreatedBy", fields: [createdBy], references: [id])
  auditEvents           FinancialAuditEvent[]

  @@index([financialClosingId, type])
  @@index([financialClosingLineId])
}

model FinancialDocument {
  id                    Int                    @id @default(autoincrement())
  financialClosingId    Int
  financialClosingLineId Int?
  physiotherapistId     Int?
  type                  FinancialDocumentType
  status                FinancialDocumentStatus @default(PENDING)
  provider              String                 @default("GOOGLE_DRIVE")
  fileName              String
  fileId                String?
  fileUrl               String?
  mimeType              String?
  fileHash              String?
  folderPath            String?
  referenceMonth        String
  metadata              Json?
  extractedData         Json?
  uploadedBy            Int?
  uploadedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialClosing      FinancialClosing       @relation(fields: [financialClosingId], references: [id], onDelete: Cascade)
  financialClosingLine  FinancialClosingLine?   @relation(fields: [financialClosingLineId], references: [id], onDelete: SetNull)
  physiotherapist       Physiotherapist?       @relation(fields: [physiotherapistId], references: [id], onDelete: SetNull)
  uploadedByUser        User?                  @relation("FinancialDocumentUploadedBy", fields: [uploadedBy], references: [id])
  auditEvents           FinancialAuditEvent[]

  @@index([financialClosingId, type])
  @@index([physiotherapistId, type])
  @@index([referenceMonth, type])
}

model FinancialAuditEvent {
  id                    Int                    @id @default(autoincrement())
  financialClosingId    Int
  financialClosingLineId Int?
  financialAdjustmentId Int?
  financialDocumentId   Int?
  paymentBatchId        Int?
  type                  FinancialAuditEventType
  actorUserId           Int?
  actorName             String?
  message               String?
  details               Json?
  createdAt             DateTime               @default(now())
  financialClosing      FinancialClosing       @relation(fields: [financialClosingId], references: [id], onDelete: Cascade)
  financialClosingLine  FinancialClosingLine?   @relation(fields: [financialClosingLineId], references: [id], onDelete: SetNull)
  financialAdjustment   FinancialAdjustment?    @relation(fields: [financialAdjustmentId], references: [id], onDelete: SetNull)
  financialDocument     FinancialDocument?      @relation(fields: [financialDocumentId], references: [id], onDelete: SetNull)
  paymentBatch          PaymentBatch?           @relation(fields: [paymentBatchId], references: [id], onDelete: SetNull)
  actorUser             User?                  @relation("FinancialAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([financialClosingId, createdAt])
  @@index([type, createdAt])
}

model PaymentBatch {
  id                    Int                    @id @default(autoincrement())
  financialClosingId    Int
  provider              String                 @default("BANCO_INTER")
  status                PaymentBatchStatus     @default(DRAFT)
  batchNumber           String?
  fileName              String?
  fileId                String?
  fileHash              String?
  recordCount           Int                    @default(0)
  totalValue            Decimal                @default(0) @db.Decimal(12, 2)
  payload               Json?
  generatedAt           DateTime?
  sentAt                DateTime?
  confirmedAt           DateTime?
  returnedAt            DateTime?
  createdBy             Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialClosing      FinancialClosing       @relation(fields: [financialClosingId], references: [id], onDelete: Cascade)
  createdByUser         User?                  @relation("PaymentBatchCreatedBy", fields: [createdBy], references: [id])
  auditEvents           FinancialAuditEvent[]
  lines                 FinancialClosingLine[]

  @@index([financialClosingId, status])
  @@index([provider, status])
}

// ==========================================
// HISTÓRICO DE VALORES (AUDITORIA)
// ==========================================

model ShiftTeamPriceHistory {
  id            Int      @id @default(autoincrement())
  shiftTeamId   Int
  shiftValue    Decimal  @db.Decimal(10, 2)
  changeReason  String?
  effectiveFrom DateTime @default(now()) // Data a partir da qual o valor é válido
  createdAt     DateTime @default(now())
  createdBy     Int? // Usuário que fez a alteração
  updatedAt     DateTime @updatedAt
  updatedBy     Int?

  shiftTeam     ShiftTeam @relation(fields: [shiftTeamId], references: [id], onDelete: Cascade)
  user          User?     @relation("PriceChangeUser", fields: [createdBy], references: [id])
  updatedByUser User?     @relation("PriceUpdateUser", fields: [updatedBy], references: [id])

  @@index([shiftTeamId, effectiveFrom])
}

model PhysiotherapistTeamPriceHistory {
  id                    Int      @id @default(autoincrement())
  physiotherapistTeamId Int
  customShiftValue      Decimal? @db.Decimal(10, 2)
  changeReason          String?
  effectiveFrom         DateTime @default(now()) // Data a partir da qual o valor é válido
  createdAt             DateTime @default(now())
  createdBy             Int? // Usuário que fez a alteração
  updatedAt             DateTime @updatedAt
  updatedBy             Int?

  physiotherapistTeam PhysiotherapistTeam @relation(fields: [physiotherapistTeamId], references: [id], onDelete: Cascade)
  user                User?               @relation("CustomPriceChangeUser", fields: [createdBy], references: [id])
  updatedByUser       User?               @relation("CustomPriceUpdateUser", fields: [updatedBy], references: [id])

  @@index([physiotherapistTeamId, effectiveFrom])
}
